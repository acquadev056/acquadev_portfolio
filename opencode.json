{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "Figma": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "figma-developer-mcp",
        "--stdio"
      ],
      "enabled": true,
      "environment": {
        "FIGMA_API_KEY": "{env:FIGMA_TOKEN}"
      }
    }
  }
}