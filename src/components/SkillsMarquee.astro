---
// SkillsMarquee.astro - Infinite marquee bands (Figma: "Skills (Infinite Marquee)" #9:2)
const bandGrey = ['Svelte', 'Next.js', 'Vue.js', 'Node.js'];
const bandLime = ['PostgreSQL', 'MongoDB', 'Redis', 'Flutter'];
---

<section id="skills" class="skills-section reveal-scroll">
  <div class="skills-header">
    <div class="skills-title-wrap">
      <span class="header-highlight" aria-hidden="true"></span>
      <h2 class="skills-title">Mis Herramientas & Habilidades</h2>
    </div>
    <svg class="skills-scribble" width="913" height="16" viewBox="0 0 913 16" fill="none" aria-hidden="true">
      <path d="M3 9 Q 150 1, 300 8 T 600 7 T 910 6" stroke="#000000" stroke-width="2.5" stroke-linecap="round" fill="none" />
    </svg>
    <p class="skills-subtitle">
      Un vistazo a las herramientas que utilizo diariamente para dar vida a ideas,<br />
      trazadas desde el boceto inicial hasta la implementación final.
    </p>
  </div>

  <div class="marquee-stack">
    <div class="marquee-band band-grey" aria-hidden="false">
      <div class="marquee-track track-left">
        <div class="marquee-items">
          {bandGrey.map((word) => (
            <span class="marquee-item">
              <span class="marquee-word">{word}</span>
              <span class="marquee-dot dot-lime">●</span>
            </span>
          ))}
        </div>
        <div class="marquee-items" aria-hidden="true">
          {bandGrey.map((word) => (
            <span class="marquee-item">
              <span class="marquee-word">{word}</span>
              <span class="marquee-dot dot-lime">●</span>
            </span>
          ))}
        </div>
      </div>
    </div>

    <div class="marquee-band band-lime">
      <div class="marquee-track track-right">
        <div class="marquee-items">
          {bandLime.map((word) => (
            <span class="marquee-item">
              <span class="marquee-word">{word}</span>
              <span class="marquee-dot dot-black">●</span>
            </span>
          ))}
        </div>
        <div class="marquee-items" aria-hidden="true">
          {bandLime.map((word) => (
            <span class="marquee-item">
              <span class="marquee-word">{word}</span>
              <span class="marquee-dot dot-black">●</span>
            </span>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .skills-section {
    padding: 120px 0;
  }

  .skills-header {
    margin-bottom: 64px;
  }

  .skills-title-wrap {
    position: relative;
    display: inline-block;
  }

  .header-highlight {
    position: absolute;
    top: 60px;
    left: 0;
    width: 100%;
    height: 24px;
    background: rgba(193, 241, 0, 0.5);
    border-radius: 2px;
    pointer-events: none;
  }

  .skills-title {
    font-family: var(--font-headline);
    font-size: 4rem;
    font-weight: 800;
    line-height: 70.4px;
    letter-spacing: -0.02em;
    color: var(--primary);
  }

  .skills-scribble {
    display: block;
    margin-top: 8px;
    max-width: 100%;
  }

  .skills-subtitle {
    font-family: var(--font-body);
    font-size: 1.25rem;
    line-height: 32px;
    color: var(--on-surface-variant);
    margin-top: 24px;
    max-width: 672px;
  }

  .marquee-stack {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    margin: 0 calc(-1 * var(--page-gutter));
  }

  .marquee-band {
    padding: 48px 0;
    overflow: hidden;
  }

  .band-grey {
    background: #EEEEEC;
  }

  .band-lime {
    background: rgba(193, 241, 0, 0.2);
  }

  .marquee-track {
    display: flex;
    width: max-content;
    align-items: center;
    gap: 32px;
  }

  .track-left {
    animation: marquee-left 30s linear infinite;
  }

  .track-right {
    animation: marquee-right 30s linear infinite;
  }

  @keyframes marquee-left {
    0% { transform: translateX(0); }
    100% { transform: translateX(-50%); }
  }

  @keyframes marquee-right {
    0% { transform: translateX(-50%); }
    100% { transform: translateX(0); }
  }

  .marquee-items {
    display: inline-flex;
    align-items: center;
    gap: 32px;
  }

  .marquee-item {
    display: inline-flex;
    align-items: center;
    gap: 32px;
  }

  .marquee-word {
    font-family: var(--font-headline);
    font-size: 4rem;
    font-weight: 800;
    line-height: 70.4px;
    letter-spacing: -0.05em;
    color: var(--primary);
    white-space: nowrap;
  }

  .marquee-dot {
    font-family: 'Liberation Serif', 'Times New Roman', serif;
    font-weight: 800;
    font-size: 3.375rem;
    line-height: 1;
  }

  .dot-lime {
    color: var(--lime-accent);
  }

  .dot-black {
    color: #000000;
  }

  @media (prefers-reduced-motion: reduce) {
    .track-left,
    .track-right {
      animation: none;
    }
  }
</style>
