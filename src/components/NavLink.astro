---
// NavLink.astro - Nav item built on the shared Button component (active = lime underline)
import Button from './Button.astro';

interface Props {
  href: string;
  label: string;
  dataNav?: string;
  isActive?: boolean;
  isExternal?: boolean;
  className?: string;
}

const { href, label, dataNav, isActive = false, isExternal = false, className = '' } = Astro.props;
---

<Button
  href={href}
  variant="link"
  size="nav"
  className={`${isActive ? 'active' : ''} ${className}`.trim()}
  dataNav={dataNav}
  target={isExternal ? '_blank' : undefined}
  rel={isExternal ? 'noopener noreferrer' : undefined}
>
  {label}
</Button>
