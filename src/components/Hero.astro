---
// Hero.astro - Home hero (Figma: "Home - Sketch Portfolio" #9:145)
import Button from './Button.astro';
import data from '../data/data.json';

const nameParts = data.profile.name.split(' ');
const firstNameLine = nameParts.slice(0, -1).join(' ');
const lastName = nameParts[nameParts.length - 1];
---

<section id="home" class="hero-section reveal-scroll">
  <svg class="hero-scribble" width="128" height="128" viewBox="0 0 128 128" fill="none" aria-hidden="true">
    <circle cx="64" cy="64" r="62" stroke="#000000" stroke-width="1.5" stroke-dasharray="6 6" opacity="0.2" />
  </svg>

  <div class="hero-layout">
    <div class="hero-content">
      <h1 class="hero-title">
        Hola, soy<br />
        <span class="hero-name-highlight">{firstNameLine}<br />{lastName}</span><br />
        .<br />
        Dibujo código y<br />
        diseño<br />
        experiencias.
      </h1>

      <p class="hero-subtitle">
        A Software Engineer with 1 year of experience developing mobile apps and software solutions. I’m also an open-source believer, so I create open-source products for developers around the world.
      </p>

      <div class="hero-actions">
        <Button href="#projects" variant="primary" size="lg">
          VER PROYECTOS
          <svg width="16" height="12" viewBox="0 0 16 12" fill="none" aria-hidden="true">
            <path d="M1 6h13" stroke="#000000" stroke-width="1.5" stroke-linecap="round" />
            <path d="M10 1.5L14.5 6 10 10.5" stroke="#000000" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </Button>
        <Button href="#about" variant="link" size="nav">
          SABER MÁS
        </Button>
      </div>
    </div>

    <div class="hero-sketch-card">
      <span class="corner-mark corner-tl" aria-hidden="true"></span>
      <span class="corner-mark corner-br" aria-hidden="true"></span>
      <img src="/assets/hero_portrait.png" alt={data.profile.name} class="portrait-img" />
    </div>
  </div>
</section>

<style>
  .hero-section {
    padding: 120px 0 0;
    position: relative;
  }

  .hero-scribble {
    position: absolute;
    top: 40px;
    left: -24px;
    pointer-events: none;
  }

  .hero-layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: 4rem;
    align-items: center;
    justify-content: space-between;
  }

  @media (min-width: 900px) {
    .hero-layout {
      grid-template-columns: 1.2fr 1fr;
    }
  }

  .hero-title {
    font-family: var(--font-headline);
    font-size: 4rem;
    font-weight: 800;
    line-height: 70.4px;
    letter-spacing: -0.02em;
    color: var(--primary);
    margin-bottom: 2rem;
  }

  .hero-name-highlight {
    background-color: rgba(193, 241, 0, 0.5);
    border-radius: 2px;
    padding: 0 10px;
    box-decoration-break: clone;
    -webkit-box-decoration-break: clone;
  }

  .hero-subtitle {
    font-family: var(--font-body);
    font-size: 1.25rem;
    font-weight: 400;
    line-height: 32px;
    color: var(--on-surface-variant);
    margin-bottom: 2.5rem;
    max-width: 576px;
  }

  .hero-actions {
    display: flex;
    gap: 24px;
    align-items: center;
  }

  .hero-sketch-card {
    position: relative;
    width: 100%;
    max-width: 455.75px;
    background: var(--background);
    border-radius: 135px 120px 120px 135px;
    padding: 16px;
    display: flex;
    justify-content: center;
    align-items: stretch;
  }

  .corner-mark {
    position: absolute;
    width: 16.28px;
    height: 16.28px;
  }

  .corner-tl {
    top: 8.14px;
    left: 15.4px;
    border-top: 1px solid var(--primary);
    border-left: 1px solid var(--primary);
  }

  .corner-br {
    bottom: 8.14px;
    right: 15.4px;
    border-bottom: 1px solid var(--primary);
    border-right: 1px solid var(--primary);
  }

  .portrait-img {
    width: 100%;
    height: 423.2px;
    object-fit: cover;
    display: block;
    border-radius: 119px 104px 104px 119px;
  }
</style>
