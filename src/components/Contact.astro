---
// Contact.astro - "Hablemos" (Figma: "Contact - acquadev" #9:361)
import Button from "./Button.astro";
import data from "../data/data.json";

const socialLinks = data.socialLinks.map((id) => data.links[id]);
const profile = data.profile;
---

<section id="contact" class="contact-section reveal-scroll">
  <div class="contact-grid">
    <div class="contact-left">
      <h2 class="contact-heading">Hablemos</h2>

      <div class="quote-wrap">
        <span class="quote-highlight" aria-hidden="true"></span>
        <p class="contact-quote">"Let's create something amazing together!"</p>
      </div>

      <svg
        class="hand-drawn-arrow"
        width="200"
        height="150"
        viewBox="0 0 200 150"
        fill="none"
        aria-hidden="true"
      >
        <path
          d="M12 34 C 80 14, 150 44, 158 112 M 138 98 L 158 112 L 166 92"
          stroke="#000000"
          stroke-width="3"
          stroke-linecap="round"
          stroke-linejoin="round"
          fill="none"></path>
      </svg>

      <div class="socials">
        {
          socialLinks.map((social) => (
            <a
              href={social.href}
              class="social-link"
              target="_blank"
              rel="noopener noreferrer"
            >
              {social.icon === "linkedin" ? (
                <svg
                  width="18"
                  height="20"
                  viewBox="0 0 18 20"
                  fill="none"
                  aria-hidden="true"
                >
                  <rect
                    x="1"
                    y="1"
                    width="16"
                    height="18"
                    rx="3"
                    stroke="#4C4546"
                    stroke-width="1.5"
                  />
                  <path
                    d="M5.5 14V8.5M5.5 6v.5"
                    stroke="#4C4546"
                    stroke-width="1.5"
                    stroke-linecap="round"
                  />
                  <rect
                    x="8.5"
                    y="9"
                    width="4"
                    height="5"
                    rx="1"
                    fill="#4C4546"
                  />
                </svg>
              ) : (
                <svg
                  width="20"
                  height="12"
                  viewBox="0 0 20 12"
                  fill="none"
                  aria-hidden="true"
                >
                  <path
                    d="M2.5 2l3.5 4-3.5 4"
                    stroke="#4C4546"
                    stroke-width="1.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    fill="none"
                  />
                  <path
                    d="M10 2l3.5 4-3.5 4"
                    stroke="#4C4546"
                    stroke-width="1.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    fill="none"
                  />
                  <path
                    d="M17.5 2l-3.5 4 3.5 4"
                    stroke="#4C4546"
                    stroke-width="1.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    fill="none"
                  />
                </svg>
              )}
              {social.label}
            </a>
          ))
        }
      </div>
    </div>

    <div class="contact-right">
      <div class="form-block">
        <form
          class="contact-form"
          onsubmit="event.preventDefault(); alert('¡Gracias! Tu mensaje ha sido enviado a {profile.name}.');"
        >
          <div class="form-group">
            <label for="name" class="label-caps form-label">TU NOMBRE</label>
            <input
              type="text"
              id="name"
              required
              class="form-input"
              placeholder={profile.shortName}
            />
          </div>

          <div class="form-group">
            <label for="email" class="label-caps form-label">TU EMAIL</label>
            <input
              type="email"
              id="email"
              required
              class="form-input"
              placeholder={profile.email}
            />
          </div>

          <div class="form-group">
            <label for="msg" class="label-caps form-label">MENSAJE</label>
            <textarea
              id="msg"
              rows="4"
              required
              class="form-input form-textarea"
              placeholder="Cuéntame sobre tu proyecto..."></textarea>
          </div>

          <div class="form-submit-row">
            <Button type="submit" variant="display" size="xl">
              Enviar mensaje
              <svg
                width="16"
                height="16"
                viewBox="0 0 16 16"
                fill="none"
                aria-hidden="true"
              >
                <path
                  d="M1.5 8L14 2l-3.5 12.5L8 10 1.5 8z"
                  stroke="#000000"
                  stroke-width="1.5"
                  stroke-linejoin="round"
                  fill="none"></path>
                <path
                  d="M8 10L14 2"
                  stroke="#000000"
                  stroke-width="1.5"
                  stroke-linejoin="round"></path>
              </svg>
            </Button>
          </div>
        </form>
      </div>
    </div>
  </div>
</section>

<style>
  .contact-section {
    padding: 120px 0 60px;
  }

  .contact-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
    align-items: stretch;
  }

  @media (min-width: 900px) {
    .contact-grid {
      grid-template-columns: 5fr 6fr;
      column-gap: 48px;
    }
  }

  .contact-left {
    display: flex;
    flex-direction: column;
    gap: 32px;
  }

  .contact-heading {
    font-family: var(--font-headline);
    font-size: 4rem;
    font-weight: 700;
    line-height: 64px;
    letter-spacing: -0.02em;
    color: var(--primary);
  }

  .quote-wrap {
    position: relative;
    width: fit-content;
  }

  .quote-highlight {
    position: absolute;
    top: 3px;
    left: 8px;
    width: 400.77px;
    height: 26px;
    background: rgba(193, 241, 0, 0.5);
    pointer-events: none;
  }

  .contact-quote {
    position: relative;
    font-family: var(--font-body);
    font-style: italic;
    font-size: 1.25rem;
    line-height: 32px;
    color: var(--on-surface-variant);
    margin: 0;
  }

  .hand-drawn-arrow {
    align-self: flex-end;
    margin-right: 40px;
    opacity: 0.8;
    transition: transform 0.3s ease;
  }

  .contact-left:hover .hand-drawn-arrow {
    transform: translate(6px, 4px) scale(1.05);
  }

  .socials {
    display: flex;
    gap: 24px;
    margin-top: auto;
  }

  .social-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 500;
    line-height: 12px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--on-surface-variant);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .social-link:hover {
    color: var(--primary);
  }

  .contact-right {
    display: flex;
    align-items: stretch;
  }

  .form-block {
    position: relative;
    flex: 1;
    background: var(--surface-container-low);
    border-radius: 14px;
    padding: 24px;
  }

  .contact-form {
    display: flex;
    flex-direction: column;
    gap: 48px;
    padding: 0 8px;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .form-label {
    color: var(--primary);
  }

  .form-input {
    font-family: var(--font-body);
    font-size: 1.25rem;
    padding: 11px 12px;
    background: #ffffff;
    border: none;
    outline: none;
    color: var(--primary);
    width: 100%;
  }

  .form-input::placeholder {
    color: #cfc4c5;
  }

  .form-input:focus {
    box-shadow: 0 0 0 2px var(--lime-accent);
  }

  .form-textarea {
    resize: vertical;
    min-height: 132px;
  }

  .form-submit-row {
    display: flex;
    justify-content: flex-start;
    padding-top: 16px;
  }
</style>
