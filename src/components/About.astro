---
// About.astro - Split layout photo + story (Figma: "Section: Split Layout" #9:215)
// Left column renders the GitHub profile README (fetched at build time) in sketchy style.
import data from '../data/data.json';
import { marked } from 'marked';

const readmeRepo =
  data.profile.readmeRepo ??
  `${data.profile.githubUsername}/${data.profile.githubUsername}`;

async function fetchReadme(repo: string): Promise<string | null> {
  for (const branch of ['main', 'master']) {
    try {
      const res = await fetch(
        `https://raw.githubusercontent.com/${repo}/${branch}/README.md`,
      );
      if (res.ok) return await res.text();
    } catch {
      // try next branch
    }
  }
  try {
    const res = await fetch(`https://api.github.com/repos/${repo}/readme`, {
      headers: {
        Accept: 'application/vnd.github.raw+json',
        'User-Agent': 'acquadev-portfolio',
      },
    });
    if (res.ok) return await res.text();
  } catch {
    // fall back to placeholder
  }
  return null;
}

const readmeMarkdown = await fetchReadme(readmeRepo);
const readmeHtml = readmeMarkdown
  ? marked.parse(readmeMarkdown, { gfm: true, async: false })
  : null;
---

<div class="about-top-grid reveal-scroll">
  <div class="readme-col">
    <div class="readme-dashed-border" aria-hidden="true"></div>
    <div class="readme-frame">
      {readmeHtml ? (
        <div class="readme-content" set:html={readmeHtml} />
      ) : (
        <p class="readme-fallback">
          El README de <strong>{readmeRepo}</strong> aún no está disponible.
          Se cargará automáticamente cuando se suba el repositorio a GitHub.
        </p>
      )}
    </div>
  </div>

  <div class="bio-content">
    <h2 class="about-title">
      Hello, I'm
      <span class="about-title-word">
        <span class="lime-swipe" aria-hidden="true"></span>
        JuniorDeveloper.
      </span>
    </h2>

    <p class="text-body-lg about-paragraph">
      I’m a creative and competitive developer, proactive learner, and a solution proposer.
    </p>

    <p class="text-body-lg about-paragraph about-paragraph-muted">
      My work bridges the gap between architectural drafting and modern UI design. I don't just build interfaces; I sketch them, outline them, and leave the construction lines visible for those who appreciate the process.
    </p>

    <div class="status-underline label-caps">
      CURRENT STATUS: SKETCHING IDEAS
    </div>
  </div>
</div>

<style>
  .about-top-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 4rem;
    align-items: center;
    margin-bottom: 120px;
  }

  @media (min-width: 900px) {
    .about-top-grid {
      grid-template-columns: 5fr 7fr;
      column-gap: 24px;
    }
  }

  .readme-col {
    position: relative;
    width: 100%;
    justify-self: center;
  }

  .readme-dashed-border {
    position: absolute;
    top: 16px;
    left: 16px;
    right: -16px;
    bottom: -16px;
    border: 2px dashed var(--primary);
    opacity: 0.5;
    pointer-events: none;
  }

  .readme-frame {
    position: relative;
    border: 2px solid var(--primary);
    background: #FFFFFF;
    border-radius: 128.5px 130px 114px 114px;
    max-height: 560px;
    overflow-y: auto;
    padding: 32px 32px 40px;
  }

  .readme-content {
    font-family: var(--font-body);
    font-size: 1rem;
    line-height: 28px;
    color: var(--on-surface-variant);
  }

  .readme-content > :first-child {
    margin-top: 0;
  }

  .readme-content > :last-child {
    margin-bottom: 0;
  }

  .readme-content h1,
  .readme-content h2,
  .readme-content h3,
  .readme-content h4 {
    font-family: var(--font-headline);
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--primary);
    line-height: 1.2;
  }

  .readme-content h1 {
    font-size: 1.875rem;
    margin: 32px 0 16px;
  }

  .readme-content h2 {
    font-size: 1.5rem;
    margin: 28px 0 12px;
    border-bottom: 2px dashed var(--primary);
    padding-bottom: 8px;
  }

  .readme-content h3 {
    font-size: 1.25rem;
    margin: 24px 0 8px;
  }

  .readme-content p {
    margin: 12px 0;
  }

  .readme-content a {
    color: var(--primary);
    text-decoration: none;
    border-bottom: 2px solid var(--lime-accent);
  }

  .readme-content a:hover {
    background-color: rgba(193, 241, 0, 0.5);
  }

  .readme-content ul,
  .readme-content ol {
    padding-left: 24px;
    margin: 12px 0;
  }

  .readme-content li {
    margin: 6px 0;
  }

  .readme-content li::marker {
    color: var(--lime-accent);
    font-weight: 700;
  }

  .readme-content code {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    background: var(--surface-container);
    padding: 2px 6px;
    border-radius: 4px;
  }

  .readme-content pre {
    background: var(--surface-container);
    border: 1px dashed var(--primary);
    border-radius: 24px 24px 24px 4px;
    padding: 16px;
    overflow-x: auto;
    margin: 16px 0;
  }

  .readme-content pre code {
    background: transparent;
    padding: 0;
    line-height: 22px;
  }

  .readme-content img {
    max-width: 100%;
    height: auto;
    display: block;
    margin: 12px auto;
  }

  .readme-content blockquote {
    margin: 16px 0;
    padding: 8px 16px;
    border-left: 3px solid var(--lime-accent);
    font-style: italic;
    background: var(--surface-container-low);
    border-radius: 0 16px 16px 0;
  }

  .readme-content table {
    border-collapse: collapse;
    width: 100%;
    margin: 16px 0;
  }

  .readme-content th,
  .readme-content td {
    border: 1px dashed var(--on-surface-variant-soft);
    padding: 8px 12px;
    text-align: left;
  }

  .readme-content th {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--primary);
    background: var(--surface-container-low);
  }

  .readme-content hr {
    border: none;
    border-top: 2px dashed var(--on-surface-variant-soft);
    margin: 24px 0;
  }

  .readme-fallback {
    font-family: var(--font-body);
    font-size: 1.125rem;
    line-height: 28px;
    color: var(--on-surface-variant);
  }

  .bio-content {
    display: flex;
    flex-direction: column;
    gap: 24px;
    padding-left: 0;
  }

  @media (min-width: 900px) {
    .bio-content {
      padding-left: 48px;
    }
  }

  .about-title {
    font-family: var(--font-headline);
    font-size: 5rem;
    font-weight: 800;
    line-height: 80px;
    letter-spacing: -0.05em;
    color: var(--primary);
    display: flex;
    flex-direction: column;
  }

  .about-title-word {
    position: relative;
    width: fit-content;
  }

  .lime-swipe {
    position: absolute;
    left: -4.38px;
    bottom: 6px;
    width: 110%;
    height: 57.43px;
    background: var(--lime-accent);
    z-index: -1;
  }

  .about-paragraph {
    color: var(--on-surface-variant);
    margin: 0;
  }

  .about-paragraph-muted {
    margin: 0;
  }

  .status-underline {
    border-bottom: 2px dashed var(--on-surface-variant);
    display: inline-block;
    padding-bottom: 4px;
    color: var(--on-surface-variant);
    width: fit-content;
  }
</style>
