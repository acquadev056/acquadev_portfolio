---
// ProjectCard.astro - Reusable project card (Figma: EL-14f93110)
interface Props {
  title?: string;
  summary: string;
  tools?: string;
  tags: string[];
  arrow?: boolean;
  stars?: number;
  forks?: number;
  updatedAt?: string;
  href?: string;
  className?: string;
}

const {
  title,
  summary,
  tools,
  tags,
  arrow = false,
  stars,
  forks,
  updatedAt,
  href,
  className = "",
} = Astro.props;
---

<a
  href={href ?? undefined}
  target={href ? "_blank" : undefined}
  rel={href ? "noopener noreferrer" : undefined}
  class="project-card-link"
>
  <article class={`project-card ${className}`}>
    <div class="project-heading">
      {title && <h3 class="project-title">{title}</h3>}
      {
        arrow && (
          <svg
            class="project-arrow"
            width="20"
            height="20"
            viewBox="0 0 22.5 22.5"
            fill="none"
            aria-hidden="true"
          >
            <path
              d="M4 18.5L18.5 4"
              stroke="currentColor"
              stroke-width="1.6"
              stroke-linecap="round"
            />
            <path
              d="M7.5 4H18.5v11"
              stroke="currentColor"
              stroke-width="1.6"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>
        )
      }
    </div>

    <p class="project-summary">{summary}</p>

    {tools && <p class="project-tools">{tools}</p>}

    <div class="project-tags">
      {tags.map((tag) => <span class="tag-pill">{tag}</span>)}
    </div>

    <div class="project-meta">
      {
        stars !== undefined && (
          <span class="project-stat">
            <svg
              width="11"
              height="11"
              viewBox="0 0 11 11"
              fill="none"
              aria-hidden="true"
            >
              <path
                d="M5.5 1l1.3 2.7 3 .4-2.2 2.1.5 3-2.6-1.4-2.6 1.4.5-3L1.2 4.1l3-.4L5.5 1z"
                stroke="currentColor"
                stroke-width="0.9"
                stroke-linejoin="round"
              />
            </svg>
            {stars}
          </span>
        )
      }
      {
        forks !== undefined && (
          <span class="project-stat">
            <svg
              width="11"
              height="11"
              viewBox="0 0 11 11"
              fill="none"
              aria-hidden="true"
            >
              <path
                d="M5.5 1v7M3 3.5h5M5.5 8.5l-2.5-3.5M5.5 8.5L8 5"
                stroke="currentColor"
                stroke-width="0.9"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
            </svg>
            {forks}
          </span>
        )
      }
      {
        updatedAt && (
          <span class="project-stat project-stat-date">{updatedAt}</span>
        )
      }
    </div>
  </article>
</a>

<style>
  .project-card-link {
    display: block;
    height: 100%;
    text-decoration: none;
    color: inherit;
  }

  .project-card {
    background: var(--background);
    border-radius: 12px;
    padding: 16px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    height: 100%;
    border: 1px solid var(--grid-line);
    text-align: center;
    align-items: center;
    transition:
      background-color 0.3s ease,
      transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  @media (min-width: 768px) {
    .project-card {
      padding: 32px;
      gap: 16px;
      border: none;
      text-align: left;
      align-items: stretch;
    }
  }

  .project-card:hover {
    background-color: rgba(193, 241, 0, 0.15);
    transform: translateY(-4px);
  }

  .project-heading {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 8px;
    width: 100%;
  }

  @media (min-width: 768px) {
    .project-heading {
      flex-direction: row;
      align-items: flex-start;
      justify-content: space-between;
      gap: 16px;
    }
  }

  .project-arrow {
    flex-shrink: 0;
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .project-card:hover .project-arrow {
    transform: translate(4px, -4px);
  }

  .project-title {
    font-family: var(--font-headline);
    font-size: 1.25rem;
    font-weight: 700;
    line-height: 1.2;
    color: var(--primary);
    word-break: break-word;
    text-align: center;
  }

  @media (min-width: 768px) {
    .project-title {
      font-size: 2.5rem;
      text-align: left;
    }
  }

  .project-summary {
    font-family: var(--font-body);
    font-size: 0.875rem;
    line-height: 1.4;
    color: var(--on-surface-variant);
    text-align: center;
  }

  @media (min-width: 768px) {
    .project-summary {
      font-size: 1.25rem;
      line-height: 32px;
      text-align: left;
    }
  }

  .project-tools {
    font-family: var(--font-body);
    font-style: italic;
    font-size: 0.8125rem;
    line-height: 1.3;
    color: var(--on-surface-variant);
    text-align: center;
  }

  @media (min-width: 768px) {
    .project-tools {
      font-size: 1rem;
      text-align: left;
    }
  }

  .project-tags {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 6px;
  }

  @media (min-width: 768px) {
    .project-tags {
      justify-content: flex-start;
      gap: 12px;
    }
  }

  .tag-pill {
    border: 1px solid var(--primary);
    border-radius: 128.5px 130px 114px 14px;
    padding: 3px 8px;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 500;
    line-height: 10px;
    letter-spacing: 0.08em;
    display: inline-flex;
    align-items: center;
    background: transparent;
    color: var(--on-background);
    transition:
      background-color 0.2s ease,
      transform 0.2s ease;
  }

  .tag-pill:hover {
    background-color: var(--lime-accent);
    transform: translateY(-2px);
  }

  .project-meta {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: auto;
    padding-top: 6px;
    width: 100%;
  }

  @media (min-width: 768px) {
    .project-meta {
      justify-content: flex-start;
      gap: 16px;
      padding-top: 8px;
    }
  }

  .project-stat {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    color: var(--on-surface-variant);
    white-space: nowrap;
  }

  .project-stat-date {
    margin-left: 0;
  }

  @media (min-width: 768px) {
    .project-stat-date {
      margin-left: auto;
    }
  }
</style>
