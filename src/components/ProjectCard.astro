---
// ProjectCard.astro - Reusable project card (Figma: EL-14f93110)
interface Props {
  title?: string;
  summary: string;
  tools?: string;
  tags: string[];
  arrow?: boolean;
  stars?: number;
  forks?: number;
  updatedAt?: string;
  href?: string;
  className?: string;
}

const {
  title,
  summary,
  tools,
  tags,
  arrow = false,
  stars,
  forks,
  updatedAt,
  href,
  className = '',
} = Astro.props;
---

<a
  href={href ?? undefined}
  target={href ? '_blank' : undefined}
  rel={href ? 'noopener noreferrer' : undefined}
  class="project-card-link"
>
  <article class={`project-card ${className}`}>
    <div class="project-heading">
      {title && <h3 class="project-title">{title}</h3>}
      {arrow && (
        <svg class="project-arrow" width="22.5" height="22.5" viewBox="0 0 22.5 22.5" fill="none" aria-hidden="true">
          <path d="M4 18.5L18.5 4" stroke="#000000" stroke-width="1.6" stroke-linecap="round" />
          <path d="M7.5 4H18.5v11" stroke="#000000" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      )}
    </div>

    <p class="project-summary">{summary}</p>

    {tools && <p class="project-tools">{tools}</p>}

    <div class="project-tags">
      {tags.map((tag) => (
        <span class="tag-pill">{tag}</span>
      ))}
    </div>

    <div class="project-meta">
      {stars !== undefined && (
        <span class="project-stat">
          <svg width="11" height="11" viewBox="0 0 11 11" fill="none" aria-hidden="true">
            <path d="M5.5 1l1.3 2.7 3 .4-2.2 2.1.5 3-2.6-1.4-2.6 1.4.5-3L1.2 4.1l3-.4L5.5 1z" stroke="#000000" stroke-width="0.9" stroke-linejoin="round" />
          </svg>
          {stars}
        </span>
      )}
      {forks !== undefined && (
        <span class="project-stat">
          <svg width="11" height="11" viewBox="0 0 11 11" fill="none" aria-hidden="true">
            <path d="M5.5 1v7M3 3.5h5M5.5 8.5l-2.5-3.5M5.5 8.5L8 5" stroke="#000000" stroke-width="0.9" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
          {forks}
        </span>
      )}
      {updatedAt && <span class="project-stat project-stat-date">{updatedAt}</span>}
    </div>
  </article>
</a>

<style>
  .project-card-link {
    display: block;
    height: 100%;
    text-decoration: none;
    color: inherit;
  }

  .project-card {
    background: var(--background);
    border-radius: 128.5px 130px 114px 114px;
    padding: 32px;
    display: flex;
    flex-direction: column;
    gap: 16px;
    height: 100%;
    transition: background-color 0.3s ease, transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .project-card:hover {
    background-color: rgba(193, 241, 0, 0.15);
    transform: translateY(-4px);
  }

  .project-heading {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 16px;
  }

  .project-arrow {
    flex-shrink: 0;
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .project-card:hover .project-arrow {
    transform: translate(4px, -4px);
  }

  .project-title {
    font-family: var(--font-headline);
    font-size: 2.5rem;
    font-weight: 700;
    line-height: 48px;
    color: var(--primary);
  }

  .project-summary {
    font-family: var(--font-body);
    font-size: 1.25rem;
    line-height: 32px;
    color: var(--on-surface-variant);
  }

  .project-tools {
    font-family: var(--font-body);
    font-style: italic;
    font-size: 1rem;
    line-height: 25.6px;
    color: var(--on-surface-variant);
  }

  .project-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .tag-pill {
    border: 1px solid var(--primary);
    border-radius: 128.5px 130px 114px 14px;
    padding: 4px 12px;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 500;
    line-height: 12px;
    letter-spacing: 0.1em;
    display: inline-flex;
    align-items: center;
    background: transparent;
    color: var(--on-background);
    transition: background-color 0.2s ease, transform 0.2s ease;
  }

  .tag-pill:hover {
    background-color: var(--lime-accent);
    transform: translateY(-2px);
  }

  .project-meta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 16px;
    margin-top: auto;
    padding-top: 8px;
  }

  .project-stat {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    color: var(--on-surface-variant);
    white-space: nowrap;
  }

  .project-stat-date {
    margin-left: auto;
  }
</style>
